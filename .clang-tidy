# Artha clang-tidy configuration.
#
# Scope: the checks below are high-signal for this codebase (real BUGS in
# control flow, suspicious conversions). System GTK/GLib headers are out of
# scope via HeaderFilterRegex — they contribute thousands of false positives
# (e.g. bugprone-reserved-identifier against gtype.h) that are not actionable
# here.
#
# Run against a compile database generated by xmake (gitignored sandbox):
#   PATH=/usr/bin:$PATH xmake project -P . -k compile_commands sandbox
#   clang-tidy -p sandbox src/*.c
#
# Known remaining findings are in src/libnotify.c, the vendored Win32-only
# libnotify shim (built exclusively on Windows, untestable on POSIX hosts).
Checks: >
  clang-analyzer-*,
  bugprone-*,
  misc-*,
  -misc-include-cleaner
HeaderFilterRegex: '.*/src/.*'
WarningsAsErrors: ''
