{
    "app-id": "org.artha.Artha",
    "runtime": "org.gnome.Platform",
    "runtime-version": "51",
    "sdk": "org.gnome.Sdk",
    "command": "artha",
    "separate-locales": false,
    "finish-args": [
        "--share=ipc",
        "--socket=x11",
        "--device=dri",
        "--talk-name=org.freedesktop.Notifications",
        "--own-name=org.artha.unique"
    ],
    "cleanup": [
        "/bin/xmake",
        "/include",
        "/lib/*.a",
        "/lib/*.la",
        "/lib/pkgconfig"
    ],
    "modules": [
        {
            "name": "xmake",
            "buildsystem": "simple",
            "sources": [
                {
                    "type": "file",
                    "url": "https://github.com/xmake-io/xmake/releases/download/v3.1.2/xmake-bundle-v3.1.2.linux.x86_64",
                    "sha256": "ac216aa71f4954cc1129aabf1099571d618211c1ef8db8fba871377ec5fb47cd"
                }
            ],
            "build-commands": [
                "install -Dm755 xmake-bundle-v3.1.2.linux.x86_64 /app/bin/xmake"
            ]
        },
        {
            "name": "wordnet",
            "buildsystem": "simple",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://wordnetcode.princeton.edu/3.0/WordNet-3.0.tar.bz2",
                    "sha256": "6c492d0c7b4a40e7674d088191d3aa11f373bb1da60762e098b8ee2dda96ef22"
                }
            ],
            "build-commands": [
                "cd lib && gcc -I../include -DDEFAULTPATH='\"/app/dict\"' -O2 -std=gnu11 -c binsrch.c morph.c search.c wnglobal.c wnhelp.c wnrtl.c wnutil.c",
                "cd lib && ar rcs libwordnet.a *.o",
                "install -Dm644 lib/libwordnet.a /app/lib/libwordnet.a",
                "install -Dm644 include/wn.h /app/include/wn.h"
            ]
        },
        {
            "name": "wordnet-dict",
            "buildsystem": "simple",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://wordnetcode.princeton.edu/wn3.1.dict.tar.gz",
                    "sha256": "3f7d8be8ef6ecc7167d39b10d66954ec734280b5bdcd57f7d9eafe429d11c22a"
                }
            ],
            "build-commands": [
                "install -d /app/dict",
                "find . -mindepth 1 -maxdepth 1 ! -name dbfiles -exec cp -a {} /app/dict/ \\;"
            ]
        },
        {
            "name": "artha",
            "buildsystem": "simple",
            "sources": [
                {
                    "type": "dir",
                    "path": "../"
                }
            ],
            "build-commands": [
                "CPATH=/app/include LIBRARY_PATH=/app/lib xmake f --prefix=/app -m release",
                "CPATH=/app/include LIBRARY_PATH=/app/lib xmake",
                "CPATH=/app/include LIBRARY_PATH=/app/lib xmake install -o /app"
            ]
        }
    ]
}
